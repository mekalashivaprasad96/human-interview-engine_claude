{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experience Story Bank",
  "description": "Structured repository of candidate experiences, both documented and enriched, with full scenario models",
  "type": "object",
  "required": ["version", "stories", "index"],
  "properties": {
    "version": { "type": "string", "const": "4.0.0" },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "employer", "period", "status", "scenario"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["project", "incident", "migration", "optimization", "leadership", "customer", "failure", "innovation", "process-improvement"] },
          "employer": { "type": "string" },
          "period": { "type": "string" },
          "duration_months": { "type": "number" },
          "status": { "type": "string", "enum": ["documented", "enriched", "simulated", "confirmed"] },
          "scenario": {
            "type": "object",
            "required": ["business_objective", "scope", "technical_environment", "architecture", "candidate_role", "individual_contributions", "outcomes"],
            "properties": {
              "business_objective": { "type": "string" },
              "scope": { "type": "string" },
              "technical_environment": {
                "type": "object",
                "properties": {
                  "primary_technologies": { "type": "array", "items": { "type": "string" } },
                  "infrastructure": { "type": "string" },
                  "scale": { "type": "object" },
                  "dependencies": { "type": "array", "items": { "type": "string" } },
                  "legacy_constraints": { "type": "array", "items": { "type": "string" } }
                }
              },
              "architecture": {
                "type": "object",
                "properties": {
                  "pattern": { "type": "string" },
                  "components": { "type": "array", "items": { "type": "string" } },
                  "data_flow": { "type": "string" },
                  "key_decisions": { "type": "array", "items": { "type": "string" } },
                  "tradeoffs": { "type": "array", "items": { "type": "string" } }
                }
              },
              "candidate_role": { "type": "string" },
              "individual_contributions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "action": { "type": "string" },
                    "ownership": { "type": "string", "enum": ["sole", "primary", "shared", "advisory", "validation"] },
                    "impact": { "type": "string" }
                  }
                }
              },
              "team_structure": {
                "type": "object",
                "properties": {
                  "size": { "type": "number" },
                  "roles": { "type": "array", "items": { "type": "string" } },
                  "candidate_position": { "type": "string" }
                }
              },
              "implementation_details": {
                "type": "object",
                "properties": {
                  "key_configurations": { "type": "array", "items": { "type": "string" } },
                  "algorithms_approaches": { "type": "array", "items": { "type": "string" } },
                  "testing_strategy": { "type": "string" },
                  "deployment_approach": { "type": "string" },
                  "monitoring_observability": { "type": "array", "items": { "type": "string" } },
                  "security_measures": { "type": "array", "items": { "type": "string" } }
                }
              },
              "challenges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "description": { "type": "string" },
                    "root_cause": { "type": "string" },
                    "resolution": { "type": "string" },
                    "candidate_involvement": { "type": "string" }
                  }
                }
              },
              "outcomes": {
                "type": "object",
                "properties": {
                  "metrics": { "type": "array", "items": { "type": "string" } },
                  "business_impact": { "type": "string" },
                  "technical_improvements": { "type": "array", "items": { "type": "string" } },
                  "lessons_learned": { "type": "array", "items": { "type": "string" } }
                }
              },
              "evidence_classification": {
                "type": "object",
                "properties": {
                  "documented_elements": { "type": "array", "items": { "type": "string" } },
                  "confirmed_elements": { "type": "array", "items": { "type": "string" } },
                  "inferred_elements": { "type": "array", "items": { "type": "string" } },
                  "simulated_elements": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "reusable_for": { "type": "array", "items": { "type": "string" } },
          "followup_resilience": { "type": "number", "minimum": 0, "maximum": 1 },
          "used_in_sessions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "index": {
      "type": "object",
      "properties": {
        "by_employer": { "type": "object" },
        "by_type": { "type": "object" },
        "by_technology": { "type": "object" },
        "by_competency": { "type": "object" },
        "by_scenario": { "type": "object" }
      }
    }
  }
}