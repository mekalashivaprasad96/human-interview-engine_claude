{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulated Project",
  "description": "Detailed, technically coherent simulated project scenario for immersive interview mode",
  "type": "object",
  "required": ["version", "project_id", "employer_context", "architecture", "numerical_model", "implementation", "operations", "validation"],
  "properties": {
    "version": { "type": "string", "const": "4.0.0" },
    "project_id": { "type": "string" },
    "employer_context": {
      "type": "object",
      "required": ["employer", "industry", "period", "business_objective", "team_structure"],
      "properties": {
        "employer": { "type": "string" },
        "industry": { "type": "string" },
        "period": { "type": "string" },
        "business_objective": { "type": "string" },
        "project_scope": { "type": "string" },
        "team_structure": {
          "type": "object",
          "properties": {
            "total_size": { "type": "number" },
            "engineering": { "type": "number" },
            "operations": { "type": "number" },
            "product": { "type": "number" },
            "candidate_role": { "type": "string" },
            "candidate_level": { "type": "string" }
          }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "stakeholders": { "type": "array", "items": { "type": "string" } }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["pattern", "components", "data_flow", "technology_stack", "infrastructure"],
      "properties": {
        "pattern": { "type": "string" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "technology": { "type": "string" },
              "responsibility": { "type": "string" },
              "scale": { "type": "object" },
              "dependencies": { "type": "array", "items": { "type": "string" } },
              "configuration": { "type": "object" }
            }
          }
        },
        "data_flow": { "type": "string" },
        "technology_stack": {
          "type": "object",
          "properties": {
            "languages": { "type": "array", "items": { "type": "string" } },
            "frameworks": { "type": "array", "items": { "type": "string" } },
            "databases": { "type": "array", "items": { "type": "string" } },
            "messaging": { "type": "array", "items": { "type": "string" } },
            "infrastructure": { "type": "array", "items": { "type": "string" } },
            "monitoring": { "type": "array", "items": { "type": "string" } },
            "ci_cd": { "type": "array", "items": { "type": "string" } }
          }
        },
        "infrastructure": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "regions": { "type": "array", "items": { "type": "string" } },
            "compute": { "type": "object" },
            "storage": { "type": "object" },
            "network": { "type": "object" },
            "gpu": { "type": "object" }
          }
        },
        "key_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": { "type": "string" },
              "alternatives": { "type": "array", "items": { "type": "string" } },
              "rationale": { "type": "string" },
              "tradeoffs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "numerical_model": {
      "type": "object",
      "required": ["compute", "throughput", "latency", "availability", "cost"],
      "properties": {
        "compute": {
          "type": "object",
          "properties": {
            "nodes": { "type": "number" },
            "cpus_per_node": { "type": "number" },
            "memory_per_node_gb": { "type": "number" },
            "gpus_per_node": { "type": "number" },
            "total_gpus": { "type": "number" },
            "gpu_type": { "type": "string" }
          }
        },
        "throughput": {
          "type": "object",
          "properties": {
            "requests_per_second": { "type": "number" },
            "peak_rps": { "type": "number" },
            "daily_requests": { "type": "number" },
            "data_volume_tb_per_day": { "type": "number" }
          }
        },
        "latency": {
          "type": "object",
          "properties": {
            "p50_ms": { "type": "number" },
            "p95_ms": { "type": "number" },
            "p99_ms": { "type": "number" },
            "baseline_p50_ms": { "type": "number" },
            "improvement_pct": { "type": "number" }
          }
        },
        "availability": {
          "type": "object",
          "properties": {
            "target_pct": { "type": "number" },
            "actual_pct": { "type": "number" },
            "downtime_minutes_per_month": { "type": "number" },
            "incidents_per_month": { "type": "number" },
            "mttr_minutes": { "type": "number" }
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "monthly_usd": { "type": "number" },
            "cost_per_request": { "type": "number" },
            "optimization_savings_pct": { "type": "number" }
          }
        },
        "team_metrics": {
          "type": "object",
          "properties": {
            "team_size": { "type": "number" },
            "on_call_rotation": { "type": "number" },
            "deploys_per_week": { "type": "number" },
            "lead_time_hours": { "type": "number" }
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "duration_weeks": { "type": "number" },
              "deliverables": { "type": "array", "items": { "type": "string" } },
              "candidate_ownership": { "type": "string" }
            }
          }
        },
        "key_configurations": { "type": "array", "items": { "type": "string" } },
        "algorithms_approaches": { "type": "array", "items": { "type": "string" } },
        "testing": {
          "type": "object",
          "properties": {
            "unit_coverage_pct": { "type": "number" },
            "integration_tests": { "type": "boolean" },
            "load_tests": { "type": "boolean" },
            "chaos_tests": { "type": "boolean" },
            "canary_deployment": { "type": "boolean" }
          }
        },
        "deployment": {
          "type": "object",
          "properties": {
            "strategy": { "type": "string" },
            "environments": { "type": "array", "items": { "type": "string" } },
            "rollback_time_minutes": { "type": "number" }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "properties": {
        "monitoring": { "type": "array", "items": { "type": "string" } },
        "alerting": { "type": "array", "items": { "type": "string" } },
        "incident_response": { "type": "string" },
        "on_call": { "type": "string" },
        "runbooks": { "type": "array", "items": { "type": "string" } },
        "capacity_planning": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "consistency_checks": { "type": "array", "items": { "type": "string" } },
        "numerical_invariants": { "type": "array", "items": { "type": "string" } },
        "technology_timeline_validated": { "type": "boolean" },
        "seniority_aligned": { "type": "boolean" },
        "cross_followup_tested": { "type": "boolean" }
      }
    },
    "evidence_classification": {
      "type": "object",
      "properties": {
        "simulated_elements": { "type": "array", "items": { "type": "string" } },
        "inferred_from_resume": { "type": "array", "items": { "type": "string" } },
        "general_knowledge": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}