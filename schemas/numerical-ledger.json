{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Numerical Ledger",
  "description": "Persistent numerical ledger tracking all quantities, units, calculations, and consistency invariants across interview session",
  "type": "object",
  "required": ["version", "entries", "invariants", "validation_log"],
  "properties": {
    "version": { "type": "string", "const": "4.0.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "quantity", "value", "unit", "scope", "source", "evidence_class", "timestamp"],
        "properties": {
          "id": { "type": "string" },
          "quantity": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "scope": {
            "type": "object",
            "properties": {
              "project_id": { "type": "string" },
              "component": { "type": "string" },
              "period": { "type": "string" },
              "measurement_context": { "type": "string" }
            }
          },
          "source": { "type": "string", "enum": ["resume", "candidate_confirmed", "calculated", "inferred", "simulated", "interviewer_provided"] },
          "evidence_class": { "type": "string", "enum": ["documented", "confirmed", "verified_numerical", "calculated_numerical", "technical_knowledge", "transferable", "contextual_inference", "illustrative_estimate", "simulated"] },
          "precision": { "type": "string" },
          "baseline": { "type": "boolean" },
          "derived_from": { "type": "array", "items": { "type": "string" } },
          "calculation_method": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "validated": { "type": "boolean" },
          "conflicts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "expression", "status"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "expression": { "type": "string" },
          "involved_entries": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["valid", "violated", "unchecked"] },
          "last_checked": { "type": "string", "format": "date-time" },
          "violation_details": { "type": "string" }
        }
      }
    },
    "validation_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "check_type": { "type": "string" },
          "entries_checked": { "type": "array", "items": { "type": "string" } },
          "result": { "type": "string", "enum": ["pass", "fail", "warning"] },
          "details": { "type": "string" }
        }
      }
    },
    "computed_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "derived_from": { "type": "array", "items": { "type": "string" } },
          "formula": { "type": "string" },
          "last_computed": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}