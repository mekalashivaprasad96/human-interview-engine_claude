{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Professional World Model",
  "description": "Comprehensive model of the candidate's professional world including employer contexts, industry environments, and transferable knowledge",
  "type": "object",
  "required": ["version", "employers", "industries", "knowledge_map", "gaps"],
  "properties": {
    "version": { "type": "string", "const": "4.0.0" },
    "employers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "industry", "business_model", "operational_priorities", "technology_context", "organizational_complexity", "regulatory_context", "customer_expectations", "employment_periods"],
        "properties": {
          "name": { "type": "string" },
          "industry": { "type": "string" },
          "business_model": { "type": "string" },
          "operational_priorities": { "type": "array", "items": { "type": "string" } },
          "technology_context": {
            "type": "object",
            "properties": {
              "primary_stack": { "type": "array", "items": { "type": "string" } },
              "infrastructure": { "type": "string" },
              "scale": { "type": "string" },
              "adoption_timeline": { "type": "object" },
              "legacy_systems": { "type": "array", "items": { "type": "string" } }
            }
          },
          "organizational_complexity": {
            "type": "string",
            "enum": ["startup", "growth", "mature", "enterprise", "conglomerate"]
          },
          "regulatory_context": { "type": "array", "items": { "type": "string" } },
          "customer_expectations": { "type": "array", "items": { "type": "string" } },
          "employment_periods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string" },
                "start_date": { "type": "string", "format": "date" },
                "end_date": { "type": "string", "format": "date" },
                "responsibilities": { "type": "array", "items": { "type": "string" } },
                "scope": { "type": "string" }
              }
            }
          },
          "evidence_status": { "type": "string", "enum": ["documented", "inferred", "public_knowledge"] }
        }
      }
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "characteristics", "typical_priorities", "common_technologies", "regulatory_environment"],
        "properties": {
          "name": { "type": "string" },
          "characteristics": { "type": "array", "items": { "type": "string" } },
          "typical_priorities": { "type": "array", "items": { "type": "string" } },
          "common_technologies": { "type": "array", "items": { "type": "string" } },
          "regulatory_environment": { "type": "array", "items": { "type": "string" } },
          "operational_constraints": { "type": "array", "items": { "type": "string" } },
          "candidate_experience_years": { "type": "number" }
        }
      }
    },
    "knowledge_map": {
      "type": "object",
      "properties": {
        "technical_domains": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "depth": { "type": "string", "enum": ["surface", "working", "deep", "expert"] },
              "source": { "type": "string", "enum": ["direct_experience", "adjacent_experience", "study", "transferable"] },
              "last_used": { "type": "string", "format": "date" },
              "project_contexts": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "business_domains": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "depth": { "type": "string", "enum": ["awareness", "working", "deep", "expert"] },
              "source": { "type": "string", "enum": ["direct_experience", "adjacent_experience", "study", "transferable"] },
              "customer_facing": { "type": "boolean" }
            }
          }
        },
        "cross_domain_connections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_domain": { "type": "string" },
              "to_domain": { "type": "string" },
              "connection_type": { "type": "string" },
              "strength": { "type": "string", "enum": ["weak", "moderate", "strong"] }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "gap_type": { "type": "string", "enum": ["technology", "scale", "domain", "leadership", "business"] },
          "description": { "type": "string" },
          "relevance_to_target": { "type": "string", "enum": ["critical", "important", "nice-to-have", "irrelevant"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "inferred_responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "employer": { "type": "string" },
          "period": { "type": "string" },
          "responsibility": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "basis": { "type": "string" }
        }
      }
    }
  }
}