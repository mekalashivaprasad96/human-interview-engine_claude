{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "communication_preferences.schema.json",
  "title": "CommunicationPreferences",
  "type": "object",
  "required": [
    "candidate_id",
    "preferred_contractions",
    "target_wpm",
    "verbosity_bias",
    "banned_phrases",
    "learned_rules"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "preferred_contractions": {"type": "boolean"},
    "target_wpm": {"type": "integer", "minimum": 90, "maximum": 210},
    "verbosity_bias": {"type": "string", "enum": ["concise", "balanced", "detailed"]},
    "banned_phrases": {"type": "array", "items": {"type": "string"}},
    "preferred_terminology": {"type": "object"},
    "learned_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "category", "rule_text", "source", "active"],
        "properties": {
          "rule_id": {"type": "string"},
          "category": {"type": "string"},
          "rule_text": {"type": "string"},
          "source": {"type": "string"},
          "created_at": {"type": "string"},
          "active": {"type": "boolean"}
        }
      }
    }
  }
}
