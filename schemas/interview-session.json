{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interview Session",
  "description": "Complete interview session state including all Q&A, context, and memory",
  "type": "object",
  "required": ["version", "session_id", "candidate_profile_id", "job_description", "mode", "history", "memory"],
  "properties": {
    "version": { "type": "string", "const": "4.0.0" },
    "session_id": { "type": "string" },
    "candidate_profile_id": { "type": "string" },
    "job_description": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "analysis": { "type": "object" },
        "source": { "type": "string" },
        "received_at": { "type": "string", "format": "date-time" }
      }
    },
    "mode": { "type": "string", "enum": ["immersive", "authentic", "technical", "recruiter", "hiring-manager", "behavioral", "system-design", "executive", "cognitive", "coaching"] },
    "interviewer_context": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "known_background": { "type": "string" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn", "timestamp", "interviewer_input", "candidate_response", "metadata"],
        "properties": {
          "turn": { "type": "number" },
          "timestamp": { "type": "string", "format": "date-time" },
          "interviewer_input": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "source": { "type": "string", "enum": ["text", "speech_transcript", "voice"] },
              "intent": { "type": "string" },
              "type": { "type": "string" },
              "entities": { "type": "array", "items": { "type": "string" } }
            }
          },
          "candidate_response": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "reasoning_trace": { "type": "object" },
              "evidence_used": { "type": "array", "items": { "type": "string" } },
              "numerical_entries_referenced": { "type": "array", "items": { "type": "string" } },
              "stories_referenced": { "type": "array", "items": { "type": "string" } },
              "mode_at_response": { "type": "string" }
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "followup_of": { "type": "number" },
              "topic": { "type": "string" },
              "depth_level": { "type": "number" },
              "pressure_indicator": { "type": "string" },
              "correction_made": { "type": "boolean" }
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "employers_discussed": { "type": "array", "items": { "type": "string" } },
        "projects_discussed": { "type": "array", "items": { "type": "string" } },
        "architectures_established": { "type": "array", "items": { "type": "string" } },
        "technologies_discussed": { "type": "array", "items": { "type": "string" } },
        "technology_versions": { "type": "object" },
        "implementation_decisions": { "type": "array", "items": { "type": "string" } },
        "numerical_values_established": { "type": "array", "items": { "type": "string" } },
        "responsibilities_clarified": { "type": "array", "items": { "type": "string" } },
        "ownership_claims": { "type": "array", "items": { "type": "string" } },
        "interviewer_provided_info": { "type": "array", "items": { "type": "string" } },
        "assumptions_established": { "type": "array", "items": { "type": "string" } },
        "evidence_status_updates": { "type": "array", "items": { "type": "string" } },
        "unresolved_questions": { "type": "array", "items": { "type": "string" } },
        "stories_used": { "type": "array", "items": { "type": "string" } },
        "corrections_made": { "type": "array", "items": { "type": "string" } },
        "communication_preferences_noted": { "type": "array", "items": { "type": "string" } }
      }
    },
    "numerical_ledger_id": { "type": "string" },
    "story_bank_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "paused", "completed", "archived"] }
  }
}